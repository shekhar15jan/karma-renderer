{
  "name": "karma-renderer",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Karma OS Visual Rendering Engine - component-based HTML/SVG rendering via Puppeteer",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "dev": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "elkjs": "^0.9.3",
    "express": "^4.19.2",
    "puppeteer": "^23.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/puppeteer": "^7.0.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
